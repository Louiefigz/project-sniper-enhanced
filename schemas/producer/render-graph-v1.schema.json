{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/render-graph-v1.schema.json",
  "title": "RenderGraphV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "toolchainHash", "rootNodeId", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "graphId": { "$ref": "#/$defs/stableId" },
    "toolchainHash": { "$ref": "#/$defs/sha256" },
    "rootNodeId": { "$ref": "#/$defs/stableId" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "kind",
          "dependencies",
          "inputDigests",
          "outputArtifactHash",
          "frameRange"
        ],
        "properties": {
          "nodeId": { "$ref": "#/$defs/stableId" },
          "kind": {
            "enum": [
              "source-snapshot",
              "timeline-map",
              "base-segment",
              "dialogue-stem",
              "scene-unit",
              "caption-shard",
              "composite-window",
              "preview",
              "final-export"
            ]
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableId" }
          },
          "inputDigests": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/stableId" },
            "additionalProperties": { "$ref": "#/$defs/sha256" }
          },
          "outputArtifactHash": {
            "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
          },
          "frameRange": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["startFrame", "endFrameExclusive"],
                "properties": {
                  "startFrame": { "type": "integer", "minimum": 0 },
                  "endFrameExclusive": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    }
  }
}
