{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unapproved full-program treatment proposal",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "summary", "clauses", "beats", "operations", "openingEndAnchor", "continuityEndAnchor", "audioPolicy", "colorPolicy"],
  "properties": {
    "schemaVersion": {"const": 2},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "clauses": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/clause"}},
    "beats": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/beat"}},
    "operations": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/operation"}},
    "openingEndAnchor": {"type": ["integer", "null"], "minimum": 0, "maximum": 60001},
    "continuityEndAnchor": {"type": ["integer", "null"], "minimum": 0, "maximum": 60001},
    "audioPolicy": {"const": "preserve-full-program"},
    "colorPolicy": {"enum": ["preserve", "warm", "none"]}
  },
  "$defs": {
    "indices": {"type": "array", "maxItems": 128, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "quote", "disposition", "rationale", "operationIndices"],
      "properties": {
        "start": {"type": "integer", "minimum": 0, "maximum": 20000},
        "end": {"type": "integer", "minimum": 1, "maximum": 20000},
        "quote": {"type": "string", "minLength": 1, "maxLength": 20000},
        "disposition": {"enum": ["supported", "ambiguous", "unsupported", "cut-affecting"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "operationIndices": {"$ref": "#/$defs/indices"}
      }
    },
    "beat": {
      "type": "object", "additionalProperties": false,
      "required": ["startAnchor", "endAnchorExclusive", "purpose", "summary", "supportsBeatIndices"],
      "properties": {
        "startAnchor": {"type": "integer", "minimum": 0, "maximum": 60001},
        "endAnchorExclusive": {"type": "integer", "minimum": 1, "maximum": 60001},
        "purpose": {"enum": ["opening", "body", "closing"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "supportsBeatIndices": {"$ref": "#/$defs/indices"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "clauseIndex", "beatIndex", "catalogKind", "variables", "grade", "startAnchor", "endAnchorExclusive"],
      "properties": {
        "type": {"enum": ["catalog-graphic", "grade", "preserve-cut"]},
        "clauseIndex": {"type": "integer", "minimum": 0, "maximum": 127},
        "beatIndex": {"type": ["integer", "null"], "minimum": 0, "maximum": 127},
        "startAnchor": {"type": ["integer", "null"], "minimum": 0, "maximum": 60001},
        "endAnchorExclusive": {"type": ["integer", "null"], "minimum": 0, "maximum": 60001},
        "catalogKind": {"type": ["string", "null"], "maxLength": 100},
        "variables": {"type": ["array", "null"], "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "value"],
          "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 100},
            "value": {"type": ["string", "number", "boolean"], "maxLength": 2000}}
        }},
        "grade": {"enum": ["warm", "none", null]}
      }
    }
  }
}
