{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "changedPlan": { "type": "boolean" },
    "addressedIssueCodes": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
      }
    },
    "deferredIssueCodes": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "required": [
    "schemaVersion",
    "changedPlan",
    "addressedIssueCodes",
    "deferredIssueCodes",
    "summary"
  ]
}
