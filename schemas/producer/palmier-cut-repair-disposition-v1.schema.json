{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/palmier-cut-repair-disposition-v1.schema.json",
  "title": "PalmierCutRepairDispositionV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "selected",
        "operationHash",
        "nativeStatus",
        "deliveryDisposition",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "palmier-cut-repair-disposition" },
        "selected": { "const": false },
        "operationHash": { "$ref": "#/$defs/sha256" },
        "nativeStatus": { "const": "skipped" },
        "deliveryDisposition": { "const": "local-exact-only" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "selected",
        "operationHash",
        "nativeStatus",
        "deliveryDisposition",
        "sampleExact",
        "repairSpeed",
        "repairRetime",
        "reason",
        "requiresRepairFragmentImport",
        "projectionHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "palmier-cut-repair-disposition" },
        "selected": { "const": true },
        "operationHash": { "$ref": "#/$defs/sha256" },
        "nativeStatus": { "const": "unsupported" },
        "deliveryDisposition": { "const": "baked-exact-master" },
        "sampleExact": { "const": false },
        "repairSpeed": {
          "$ref": "positive-rational-v1.schema.json"
        },
        "repairRetime": { "$ref": "#/$defs/retime" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "requiresRepairFragmentImport": { "const": true },
        "projectionHash": { "$ref": "#/$defs/sha256" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "selected",
        "operationHash",
        "nativeStatus",
        "deliveryDisposition",
        "sampleExact",
        "repairSpeed",
        "repairRetime",
        "reason",
        "requiresRepairFragmentImport",
        "expectedCuts",
        "expectedTotalFrames",
        "projectionHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "palmier-cut-repair-disposition" },
        "selected": { "const": true },
        "operationHash": { "$ref": "#/$defs/sha256" },
        "nativeStatus": { "const": "frame-exact-unqualified" },
        "deliveryDisposition": { "const": "baked-exact-master" },
        "sampleExact": { "const": false },
        "repairSpeed": {
          "$ref": "positive-rational-v1.schema.json"
        },
        "repairRetime": { "$ref": "#/$defs/retime" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "requiresRepairFragmentImport": { "const": true },
        "expectedCuts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cut" }
        },
        "expectedTotalFrames": { "type": "integer", "minimum": 1 },
        "projectionHash": { "$ref": "#/$defs/sha256" }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "range": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "frameRange": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "source", "frames", "speed"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "source": { "$ref": "#/$defs/range" },
        "frames": { "$ref": "#/$defs/frameRange" },
        "speed": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sampleRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSample", "endSampleExclusive"],
      "properties": {
        "startSample": { "type": "integer", "minimum": 0 },
        "endSampleExclusive": { "type": "integer", "minimum": 1 }
      }
    },
    "retime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedSpeed",
        "sourceSampleRange",
        "sourceSampleRate",
        "normalizedSourceSampleRange",
        "outputSamples",
        "effectiveRatio"
      ],
      "properties": {
        "requestedSpeed": {
          "$ref": "positive-rational-v1.schema.json"
        },
        "sourceSampleRange": { "$ref": "#/$defs/sampleRange" },
        "sourceSampleRate": { "type": "integer", "minimum": 1 },
        "normalizedSourceSampleRange": {
          "$ref": "#/$defs/sampleRange"
        },
        "outputSamples": { "type": "integer", "minimum": 1 },
        "effectiveRatio": {
          "$ref": "positive-rational-v1.schema.json"
        }
      }
    }
  }
}
