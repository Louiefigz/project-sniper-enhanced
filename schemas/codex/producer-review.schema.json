{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "stage": { "type": "string", "enum": ["cut", "plan", "rendered"] },
    "verdict": { "type": "string", "enum": ["pass", "revise", "block"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "materialIssues": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
          },
          "severity": { "type": "string", "enum": ["major", "critical"] },
          "lane": { "type": "string", "minLength": 1, "maxLength": 80 },
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "requiredAction": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "required": ["code", "severity", "lane", "message", "evidence", "requiredAction"]
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
          },
          "severity": { "type": "string", "enum": ["info", "minor"] },
          "lane": { "type": "string", "minLength": 1, "maxLength": 80 },
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "required": ["code", "severity", "lane", "message", "evidence"]
      }
    }
  },
  "required": ["schemaVersion", "stage", "verdict", "summary", "materialIssues", "findings"]
}
