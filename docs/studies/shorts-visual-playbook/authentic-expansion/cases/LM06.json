{
  "id": "LM06",
  "creator": "lewis",
  "reel": "DcUXjRkRTVu",
  "title": "A workflow of artifacts above the presenter",
  "message": "Test candidate headlines, use the winning wording, then inspect page performance and recommendations.",
  "arc": "Result promise \u2192 ad examples \u2192 budget input \u2192 metrics comparison \u2192 headline replacement \u2192 page diagnostic \u2192 recommendation result \u2192 return to presenter.",
  "foundation": "The viewer needs to inspect the thing being discussed. The upper artifact changes as the work advances, while the lower person maintains explanation and continuity. This is a clear companion to Nate's UI demonstrations, despite belonging to Lewis's account.",
  "execution": "Show the actual input, relevant action and changed result at readable scale. Preserve object identity across stages. Keep the presenter deliberately framed and secondary while the screen is the teaching target. Promote a dense result to full visual or focus its relevant region if a split cannot make it readable.",
  "avoid": "Do not use generic software screenshots or assume displayed performance is independently verified. The visible metric rows do not clearly establish that the later replacement headline is the same winner; our adaptation must preserve that lineage. Some scrolling results move too fast for detailed reading. Bright sky also weakens CTA contrast.",
  "typography": "Small white lower speech captions, upper white CTA, and typography embedded in actual-looking pink artifact captures. Capture text and overlay captions have different roles and should not duplicate each other unnecessarily.",
  "catalog": [
    "browser-device-stage",
    "ui-focus-zoom",
    "native-stacked-media"
  ],
