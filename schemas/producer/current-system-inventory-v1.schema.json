{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/current-system-inventory-v1.schema.json",
  "title": "CurrentSystemInventoryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "completeness",
    "phaseExit",
    "inventoryGaps",
    "baseline",
    "callSiteAudit",
    "authorityDiscovery",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "completeness": { "enum": ["partial", "complete"] },
    "phaseExit": { "enum": ["blocked", "passed"] },
    "inventoryGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredFixtures", "evidencePaths"],
      "properties": {
        "status": { "enum": ["required-unmeasured", "measured"] },
        "requiredFixtures": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidencePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "callSiteAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "extensions", "excludedPathSegments"],
      "properties": {
        "roots": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "extensions": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "excludedPathSegments": { "$ref": "#/$defs/nonemptyUniqueStrings" }
      }
    },
    "authorityDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "literalPrefixes",
        "artifactBindings",
        "backlog",
        "pathBoundaryEvidence",
        "persistenceDispositionEvidence"
      ],
      "properties": {
        "literalPrefixes": { "$ref": "#/$defs/nonemptyUniqueStrings" },
        "artifactBindings": { "$ref": "#/$defs/nonemptyStringMap" },
        "backlog": { "$ref": "#/$defs/stringMap" },
        "pathBoundaryEvidence": { "type": "string", "minLength": 1 },
        "persistenceDispositionEvidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "pathPattern",
          "owner",
          "authority",
          "readers",
          "writers",
          "promotionPoint",
          "fingerprintInputs",
          "durability",
          "disposition",
          "parityFixture",
          "removalCondition",
          "authorityPathTokens",
          "callSiteDispositions"
        ],
        "properties": {
          "artifactId": { "$ref": "#/$defs/id" },
          "pathPattern": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "authority": {
            "enum": ["canonical", "receipt", "derived", "compatibility-shadow"]
          },
          "readers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "writers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "promotionPoint": { "type": "string", "minLength": 1 },
          "fingerprintInputs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "durability": { "type": "string", "minLength": 1 },
          "disposition": {
            "enum": ["reuse", "extend", "adapter", "replace", "retain-shadow"]
          },
          "parityFixture": { "type": "string", "minLength": 1 },
          "removalCondition": { "type": "string", "minLength": 1 },
          "authorityPathTokens": {
            "$ref": "#/$defs/nonemptyUniqueStrings"
          },
          "callSiteDispositions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": {
              "enum": [
                "path-owner",
                "reader",
                "writer",
                "reader-writer",
                "launcher",
                "non-authority"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonemptyStringMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "stringMap": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
