{
  "id": "LM04",
  "creator": "lewis",
  "reel": "Dc_1B2lPn7j",
  "title": "Physical teaching prop, chapter changes and a tangible offer",
  "message": "Develop ads from customer pains, your proof and desired results, then test and improve them.",
  "arc": "Preview checklist \u2192 demonstrate three inputs \u2192 explain scripting \u2192 film/test/remix \u2192 show the promised guide.",
  "foundation": "The format changes with the information job: a held physical card names the inputs; gestures explain their use; location and shot changes mark chapters; the final guide preview makes the offer concrete. This is not one creator-wide low-intensity setting.",
  "execution": "Keep the real prop readable and the pointing hand visible. Place supporting examples above the person when they genuinely add to the prop. Let new chapter cues motivate scene changes. For a guide preview, show representative pages as an offer preview, not as text the viewer must fully read at speed.",
  "avoid": "The opening checklist is dense. Do not expect simultaneous reading of checklist, caption and CTA. Food movement is an attention device, not evidence of ad performance. The guide's example metrics must not become claims about the user's results.",
  "typography": "Large white shadowed phrase captions; smaller upper examples; short italic uppercase category headers; yellow emphasis on the CTA keyword. Handwritten prop labels carry a separate information role.",
  "catalog": [
    "native-media",
    "native-text",
    "browser-device-stage",
    "ui-focus-zoom"
  ],
  "alternates": [
    "LM06",
    "CR04"
  ],
