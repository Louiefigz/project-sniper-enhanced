{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/edit-batch-v1.schema.json",
  "title": "EditBatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "requestId",
    "idempotencyKey",
    "stage",
    "atomic",
    "preserveUnrelated",
    "base",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batchId": { "$ref": "#/$defs/uuid" },
    "requestId": { "$ref": "#/$defs/uuid" },
    "idempotencyKey": { "$ref": "#/$defs/uuid" },
    "stage": { "enum": ["cut", "treatment"] },
    "atomic": { "const": true },
    "preserveUnrelated": { "const": true },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectRevisionHash",
        "planContentHash",
        "manifestHash",
        "sourceSnapshotSetHash",
        "timelineMapHash",
        "canvasProfileHash",
        "destinationProfileHashes",
        "pictureLockHash"
      ],
      "properties": {
        "projectRevisionHash": { "$ref": "#/$defs/sha256" },
        "planContentHash": { "$ref": "#/$defs/sha256" },
        "manifestHash": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotSetHash": { "$ref": "#/$defs/sha256" },
        "timelineMapHash": { "$ref": "#/$defs/sha256" },
        "canvasProfileHash": { "$ref": "#/$defs/sha256" },
        "destinationProfileHashes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "pictureLockHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "operationId", "clauseId", "action"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "operationId": { "$ref": "#/$defs/uuid" },
          "clauseId": { "$ref": "#/$defs/uuid" },
          "action": {
            "oneOf": [
              { "$ref": "set-graphic-text-v1.schema.json" },
              { "$ref": "cut-restore-speech-v1.schema.json" },
              { "$ref": "treatment-operation-v1.schema.json" }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "stage": { "const": "cut" } },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "operations": {
            "items": {
              "properties": {
                "action": {
                  "$ref": "cut-restore-speech-v1.schema.json"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "operations": {
            "items": {
              "properties": {
                "action": {
                  "oneOf": [
                    { "$ref": "set-graphic-text-v1.schema.json" },
                    { "$ref": "treatment-operation-v1.schema.json" }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
