{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/short-long-route-matrix-v1.schema.json",
  "title": "ShortLongRouteMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "completeness",
    "phaseExit",
    "routeRoot",
    "routeGroups",
    "workflows",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "completeness": { "const": "complete" },
    "phaseExit": { "const": "passed" },
    "routeRoot": { "type": "string", "minLength": 1 },
    "routeGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeGroup" }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workflow" }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "behavior", "blockers"],
      "properties": {
        "status": {
          "enum": [
            "released",
            "compatibility",
            "unqualified",
            "unsupported",
            "not-applicable"
          ]
        },
        "behavior": { "type": "string", "minLength": 1 },
        "blockers": { "$ref": "#/$defs/strings" }
      }
    },
    "routeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "routes",
        "role",
        "modePolicy",
        "short",
        "longform",
        "incrementalBoundary",
        "palmierBoundary"
      ],
      "properties": {
        "groupId": { "type": "string", "minLength": 3 },
        "routes": { "$ref": "#/$defs/strings" },
        "role": { "type": "string", "minLength": 1 },
        "modePolicy": {
          "enum": ["form-neutral", "mode-aware", "delivery-only"]
        },
        "short": { "$ref": "#/$defs/disposition" },
        "longform": { "$ref": "#/$defs/disposition" },
        "incrementalBoundary": { "type": "string", "minLength": 1 },
        "palmierBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "entrypoints",
        "short",
        "longform",
        "incrementalBoundary",
        "palmierBoundary"
      ],
      "properties": {
        "workflowId": { "type": "string", "minLength": 3 },
        "entrypoints": { "$ref": "#/$defs/strings" },
        "short": { "$ref": "#/$defs/disposition" },
        "longform": { "$ref": "#/$defs/disposition" },
        "incrementalBoundary": { "type": "string", "minLength": 1 },
        "palmierBoundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
