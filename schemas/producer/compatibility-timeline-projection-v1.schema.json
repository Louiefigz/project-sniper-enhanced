{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/compatibility-timeline-projection-v1.schema.json",
  "title": "CompatibilityTimelineProjectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "approvedCutPlanHash",
    "cutTrackDigest",
    "cutDecisionsDigest",
    "compilerHash",
    "timelineMap",
    "timelineMapHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "compatibility-timeline-projection" },
    "approvedCutPlanHash": { "$ref": "#/$defs/sha256" },
    "cutTrackDigest": { "$ref": "#/$defs/sha256" },
    "cutDecisionsDigest": { "$ref": "#/$defs/sha256" },
    "compilerHash": { "$ref": "#/$defs/sha256" },
    "timelineMapHash": {
      "allOf": [{ "$ref": "#/$defs/sha256" }],
      "description": "SHA-256 of the V1 millionths-half-up integer hash view of timelineMap."
    },
    "timelineMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputDuration", "segments"],
      "properties": {
        "outputDuration": { "type": "number", "minimum": 0 },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "source_id",
        "src_start",
        "src_end",
        "speed",
        "out_start",
        "out_end",
        "audio_lead_s"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "source_id": { "type": "string", "minLength": 1 },
        "src_start": { "type": "number", "minimum": 0 },
        "src_end": { "type": "number", "exclusiveMinimum": 0 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "out_start": { "type": "number", "minimum": 0 },
        "out_end": { "type": "number", "exclusiveMinimum": 0 },
        "audio_lead_s": { "type": "number", "minimum": 0 }
      }
    }
  }
}
