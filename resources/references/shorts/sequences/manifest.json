      "version": "2026-09-17.1",
      "title": "Change the route, keep the destination",
      "scope": "original-reference-rendered-from-project-sniper-templates",
      "render_aspects": [
        "16:9"
      ],
      "lesson": "When the speaker compares ways of reaching one goal, keep the goal fixed on screen and change only the route, so the viewer compares like with like.",
      "opening": "The destination is named and placed first, before any route appears.",
      "story_arc": "goal fixed -> first route -> its cost -> second route -> its cost -> the route the speaker recommends -> hand back to the speaker",
      "payoff": "The recommended route is the last one drawn and the only one still lit.",
