{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/legacy-regression-gates-v1.schema.json",
  "title": "LegacyRegressionGateRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "completeness", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "completeness": { "const": "complete" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "lessonIds",
        "sourceDocuments",
        "ownerPhases",
        "classification",
        "implementationStatus",
        "enforcingCode",
        "fixtures",
        "evidenceArtifacts",
        "receiptBindings",
        "knownGap"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "lessonIds": { "$ref": "#/$defs/strings" },
        "sourceDocuments": { "$ref": "#/$defs/strings" },
        "ownerPhases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["P0", "P1", "P2", "P3", "P4", "P5"] }
        },
        "classification": {
          "enum": ["blocking", "diagnostic", "approved-approximation"]
        },
        "implementationStatus": { "enum": ["enforced", "blocked"] },
        "enforcingCode": { "$ref": "#/$defs/strings" },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fixture" }
        },
        "evidenceArtifacts": { "$ref": "#/$defs/strings" },
        "receiptBindings": { "$ref": "#/$defs/strings" },
        "knownGap": { "type": "string", "minLength": 1 }
      }
    }
  }
}
