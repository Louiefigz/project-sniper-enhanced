{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/caption-track-v1.schema.json",
  "title": "CaptionTrackV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "defaultPolicy", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "const": "kept-transcript" },
    "defaultPolicy": {
      "enum": ["off", "line", "karaoke"]
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "transcriptCorrectionHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "wordId": {
      "type": "string",
      "pattern": "^w-[0-9a-f]{16}$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "anchor",
        "styleId",
        "mode",
        "placement"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "pattern": "^cg-[0-9a-f]{16}$"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "wordIds"],
          "properties": {
            "kind": { "const": "word-range" },
            "wordIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/wordId" }
            }
          }
        },
        "styleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "mode": {
          "enum": ["line", "karaoke-word", "karaoke-phrase"]
        },
        "placement": {
          "enum": ["bottom-center", "lower-third", "center", "top-center"]
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "suppressUnderSceneIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
