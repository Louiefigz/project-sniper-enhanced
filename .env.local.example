# PROJECT SNIPER environment — copy to .env.local and fill in the keys.
# Next.js loads .env.local automatically; API routes pass it through to every
# spawned Python process. (Standalone script runs, e.g. scripts.frameio.review,
# need the keys exported in your shell instead.)

# ── Live-provider keys (not required for the default localhost lane) ────────

# Deepgram transcription (default/live provider for SEGMENTER / CLIPPER / PRODUCER ingest)
# Not required when SNIPER_TRANSCRIBE_PROVIDER=local-whisper.
DEEPGRAM_API_KEY=

# Anthropic API (live SEGMENTER/CLIPPER brain + FRAME.IO REVIEW vision) — console.anthropic.com
# Not required by the local Codex brain. The preserved live PRODUCER brain uses
# Claude Code subscription auth and also does not consume this API key.
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# LOCALHOST GUI lane. `npm run dev:local` sets this automatically. Local mode
# binds the app to loopback and selects local whisper.cpp for transcription.
# Producer still defaults to the Claude Code subscription CLI with the explicit
# `sonnet` model below, so local mode is private-by-default but not offline.
#SNIPER_EXECUTION_MODE=local

# Producer brain override. Claude Code is the default in both local and live
# modes. Every Claude subprocess receives an explicit model; it never inherits
# the desktop Claude Code model selection. Use a Claude alias or full model id.
#SNIPER_BRAIN_PROVIDER=legacy
#SNIPER_CLAUDE_MODEL=sonnet
#SNIPER_CODEX_BIN=codex
#SNIPER_CODEX_MODEL=gpt-5.6-sol
#SNIPER_CODEX_REASONING=ultra

# Auto Edit authoring deadline, in minutes (integer 10..240; default 45). The
# clock is PER BRAIN SPAWN — the cut pass and the visual pass each get their
# own. Raise it for full-length longform (10+ min of footage) where the visual
# pass can legitimately need more than 45 min; on expiry the brain is killed
# and the run falls back to draft salvage + review triage, or Resume Edit.
# Next must be restarted after changing this — workers inherit it at spawn.
#SNIPER_AUTHORING_TIMEOUT_MIN=45

# Review-loop kill ceilings, in minutes (integer 5..240). Overrunning one
# ABORTS the whole job, so raise these together with the authoring deadline
# for full-length longform. STAGE covers plan/cut critics + revision writers
# (default 20); the other covers rendered/QC vision-lens critics (default 25).
# Next must be restarted after changing these — workers inherit env at spawn.
#SNIPER_REVIEW_STAGE_TIMEOUT_MIN=20
#SNIPER_REVIEW_TIMEOUT_MIN=25

# The supervisor loads this file before it launches Next, so this knob really
# controls the child Node process. An explicit max-old-space-size already in
# NODE_OPTIONS wins. Valid range: integer 256..131072 MB; default 3072 MB.
# Raise it only after diagnosing memory growth—a larger heap is not a substitute
# for bounded UI polling. Auto Edit runs in a separate durable worker, so a
# dashboard restart does not cancel the edit.
#SNIPER_NEXT_HEAP_MB=3072

# Transcription override. An explicit provider always wins. Local Whisper never
# downloads a model and never falls back to Deepgram.
#SNIPER_TRANSCRIBE_PROVIDER=local-whisper

# whisper.cpp overrides (autodetected defaults: whisper-cli on PATH and
# ~/.cache/hyperframes/whisper/models/ggml-small.en.bin).
#WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
#WHISPER_CPP_MODEL=/absolute/path/to/ggml-small.en.bin
#WHISPER_CPP_LANGUAGE=en
#WHISPER_CPP_THREADS=8
#WHISPER_CPP_TIMEOUT_SECONDS=3600
#WHISPER_CPP_NO_GPU=0

# OPTIONAL — Claude Code executable (default: `claude` on PATH)
#CLAUDE_BIN=/usr/local/bin/claude

# Reference URL intake is available in the localhost UI for allowlisted
# YouTube, Instagram, and TikTok URLs. Public fetches never read browser
# cookies; the operator must opt into Chrome-cookie access for that one fetch
# with the checkbox on the reference card. There is no global cookie fallback.

# OPTIONAL — override the SEGMENTER model (default: claude-sonnet-4-6)
#ANTHROPIC_MODEL=claude-sonnet-4-6

# OPTIONAL — set to 0 to silence Python pipeline debug output (default: on)
#SNIPER_DEBUG=1

# OPTIONAL — set to 0 to silence UI/API-route debug logging (default: on)
#NEXT_PUBLIC_SNIPER_DEBUG=1

# OPTIONAL — set to 1 to force multicam pipeline debug output
#MULTICAM_DEBUG=0

# OPTIONAL — dual-cam crosstalk gate tuning (CLIPPER transcription)
#CLIPPER_CROSSTALK=0
#CLIPPER_CROSSTALK_RATIO=1.0
#CLIPPER_CROSSTALK_HANGOVER=4

# OPTIONAL — set to 1 to dump clip-preview request fixtures (test tooling)
#CLIPPER_DUMP_FIXTURE=0

# OPTIONAL — path override for the YuNet face-detection model (PRODUCER reframe)
#PRODUCER_YUNET_MODEL=

# OPTIONAL — fonts directory override for PRODUCER renders (render.py sets a default)
#PRODUCER_FONTS_DIR=

# OPTIONAL — set to 1 for an extra graphics-placement verification pass
#SNIPER_VERIFY_PLACEMENT=0
