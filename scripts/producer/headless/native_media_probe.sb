; Sniper native media admission jail (policy sniper-native-media-jail-v2).
;
; TEMPLATE. headless/native_media_runtime.py fills the two marked lines with the
; exact files the decoder loads (every path dyld opens and every real path, read
; from the Mach-O headers and hashed) and those files' ancestor directories. The
; approval pins this template's SHA-256; each receipt and launcher attestation
; records the SHA-256 of the generated text. headless/native_media_jail.py applies
; the generated profile to itself, then either replaces itself with the decoder
; or (inspect mode) reads the one input for the font/SVG recogniser.
;
; Everything is denied unless listed: no network, no process creation, no
; writes except /dev/null, no information about other processes, a fixed set of
; system settings, reads of the OS images dyld needs, the listed files and the
; one immutable input snapshot.
;
;   DECODER  real path of the ffprobe/ffmpeg executable being started (/dev/null for inspect)
;   INPUT    the content-addressed snapshot being admitted
(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-exec (literal (param "DECODER")))
(allow file-read* file-map-executable
  (subpath "/usr/lib")
  (subpath "/System/Library")
;;@DECODER-FILES@
  )
(allow file-read*
  (literal (param "INPUT"))
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/random"))
(allow file-read-metadata
  (literal "/")
  (subpath "/usr/lib")
  (subpath "/System")
;;@DECODER-DIRECTORIES@
  )
(allow file-write-data (literal "/dev/null"))
(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name "kern.osrelease") (sysctl-name "kern.osversion") (sysctl-name "kern.ostype")
  (sysctl-name "kern.version") (sysctl-name "kern.osproductversion") (sysctl-name "kern.hostname")
  (sysctl-name "kern.maxfilesperproc") (sysctl-name "kern.argmax") (sysctl-name "kern.usrstack64")
  (sysctl-name "kern.secure_kernel") (sysctl-name "kern.boottime") (sysctl-name "sysctl.proc_cputype")
  (sysctl-name "vm.footprint_suspend") (sysctl-name "kern.osvariant_status")
  (sysctl-name "security.mac.lockdown_mode_state"))
(deny process-info* (target others))
