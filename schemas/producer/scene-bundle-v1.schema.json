{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/scene-bundle-v1.schema.json",
  "title": "SceneBundleManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "fullEntry",
    "unitEntries",
    "supportedCanvases",
    "supportedFps",
    "variables",
    "assetIds",
    "seed",
    "runtime"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "$ref": "#/$defs/stableId" },
    "fullEntry": { "$ref": "#/$defs/relativeHtml" },
    "unitEntries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": { "$ref": "#/$defs/relativeHtml" }
    },
    "supportedCanvases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/canvas" }
    },
    "supportedFps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/positiveRational" }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "assetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hyperframesVersion", "gsapSha256"],
      "properties": {
        "hyperframesVersion": { "enum": ["0.7.33", "0.8.31"] },
        "gsapSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "relativeHtml": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.html$",
      "maxLength": 240
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 2, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 2, "maximum": 8192 }
      }
    },
    "positiveRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "scalar": {
      "type": ["string", "number", "boolean"],
      "maxLength": 4000
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "required", "elementIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "type": {
          "enum": ["string", "number", "boolean", "color", "enum"]
        },
        "required": { "type": "boolean" },
        "elementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "default": { "$ref": "#/$defs/scalar" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        }
      }
    }
  }
}
