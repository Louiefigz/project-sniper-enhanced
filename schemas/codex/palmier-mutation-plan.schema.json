{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["cuts", "graphics", "motion", "captions", "audio", "reframe"]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "remove_silence", "remove_words", "ripple_delete_ranges",
              "split_clips", "set_clip_properties", "set_keyframes",
              "apply_layout", "add_texts", "update_text", "add_captions",
              "denoise_audio"
            ]
          },
          "args": { "type": "object" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "required": ["tool", "args", "reason"]
      }
    }
  },
  "required": ["schemaVersion", "lanes", "operations"]
}
