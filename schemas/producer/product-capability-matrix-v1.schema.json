{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/product-capability-matrix-v1.schema.json",
  "title": "ProductCapabilityMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "completeness", "phaseExit", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "completeness": { "enum": ["partial", "complete"] },
    "phaseExit": { "enum": ["blocked", "passed"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "status",
          "codeEvidence",
          "uiEvidence",
          "skillEvidence",
          "docsEvidence",
          "blockingGates"
        ],
        "properties": {
          "capabilityId": { "$ref": "#/$defs/id" },
          "status": {
            "enum": ["released", "compatibility", "unsupported", "unqualified"]
          },
          "codeEvidence": { "$ref": "#/$defs/strings" },
          "uiEvidence": { "$ref": "#/$defs/strings" },
          "skillEvidence": { "$ref": "#/$defs/strings" },
          "docsEvidence": { "$ref": "#/$defs/strings" },
          "blockingGates": { "$ref": "#/$defs/strings" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
