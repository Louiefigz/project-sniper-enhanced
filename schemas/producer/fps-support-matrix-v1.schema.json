{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/fps-support-matrix-v1.schema.json",
  "title": "FpsSupportMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "asOf", "phaseExit", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "format": "date" },
    "phaseExit": { "enum": ["blocked", "passed"] },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "numerator",
          "denominator",
          "status",
          "evidence",
          "limits"
        ],
        "properties": {
          "surface": {
            "enum": ["graphics-comp-catalog", "producer-master", "palmier-native"]
          },
          "numerator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "status": {
            "enum": ["measured-released", "implemented-unqualified", "unsupported"]
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "limits": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
