/** Mechanical test-only exposure of existing SDK functions, with no body edits. */
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = dirname(fileURLToPath(import.meta.url));
const installed = '/Users/aaronfigueroa/development/demos/YT-Automation/PROJECT_SNIPER/templates/motion/node_modules/hyperframes/dist/cli.js';
const marker = '\n// src/cli.ts\ninit_version();';
const suffix = `
init_src();
init_fileServer2();
init_compileStage();
init_shared();
export { createCaptureSession, initializeSession, captureFrame, closeCaptureSession,
  drainBrowserPool, createFrameLookupTable, createVideoFrameInjector, createFileServer2,
  runCompileStage, materializeExtractedFramesForCompiledDir, resolveConfig,
  extractMediaMetadata, VIRTUAL_TIME_SHIM };
`;
const manifest = [];
for (const [mode, sourcePath] of [['baseline', installed], ['candidate', join(root, 'hyperframes/dist/cli.js')]]) {
  const source = readFileSync(sourcePath, 'utf8');
  const boundary = source.indexOf(marker);
  if (boundary < 0 || source.indexOf(marker, boundary + 1) >= 0) throw new Error('SDK bootstrap boundary changed');
  const target = join(root, 'hyperframes/dist', `native-${mode}-test-library.mjs`);
  const contents = source.slice(0, boundary) + suffix;
  writeFileSync(target, contents, { flag: 'wx' });
  manifest.push({ mode, sourcePath, target, sourceSha256: createHash('sha256').update(source).digest('hex'),
    prefixBytes: Buffer.byteLength(source.slice(0, boundary)),
    librarySha256: createHash('sha256').update(contents).digest('hex'),
    functionBodiesChanged: false, cliBootstrapIncluded: false });
}
writeFileSync(join(root, 'native-test-library-build.json'), JSON.stringify(manifest, null, 2), { flag: 'wx' });
console.log(JSON.stringify(manifest));
