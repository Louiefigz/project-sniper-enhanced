{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/caption-chapters-v1.schema.json",
  "title": "CaptionChaptersV1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["chapterId", "title", "wordId"],
    "properties": {
      "chapterId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^[^\\r\\n]+$"
      },
      "wordId": {
        "type": "string",
        "pattern": "^w-[0-9a-f]{16}$"
      }
    }
  }
}
