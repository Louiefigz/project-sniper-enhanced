{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/asset-record-v1.schema.json",
  "title": "AssetRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "sha256",
    "sizeBytes",
    "mime",
    "origin",
    "acquiredAt",
    "rights",
    "media",
    "provenance",
    "publicationDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "sha256": { "$ref": "#/$defs/sha256" },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "mime": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/svg+xml",
        "audio/wav",
        "audio/mpeg",
        "video/mp4",
        "video/quicktime",
        "font/ttf",
        "font/otf"
      ]
    },
    "origin": {
      "enum": [
        "operator-upload",
        "approved-library",
        "generated",
        "reference-derived"
      ]
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "rights": { "$ref": "#/$defs/rights" },
    "media": { "$ref": "#/$defs/media" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "publicationDisposition": {
      "enum": ["approved", "blocked", "expired", "needs-review"]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "allowedUses",
        "allowedPlatforms",
        "consent",
        "attributionRequired"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "allowedUses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["editorial", "commercial", "thumbnail", "cover", "loop"]
          }
        },
        "allowedPlatforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "youtube",
              "instagram",
              "linkedin",
              "tiktok",
              "facebook",
              "local-review"
            ]
          }
        },
        "consent": {
          "enum": ["not-applicable", "verified", "missing", "unknown"]
        },
        "attributionRequired": { "type": "boolean" },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "sampleRate": { "type": "integer", "minimum": 8000, "maximum": 384000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 32 },
        "hasAlpha": { "type": "boolean" },
        "colorSpace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "version", "requestHash"],
          "properties": {
            "model": { "type": "string", "minLength": 1, "maxLength": 160 },
            "version": { "type": "string", "minLength": 1, "maxLength": 160 },
            "requestHash": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  }
}
