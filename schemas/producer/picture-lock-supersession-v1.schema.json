{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/picture-lock-supersession-v1.schema.json",
  "title": "PictureLockSupersessionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "parentPictureLockHash",
    "childPictureLockHash",
    "repairOperationHash",
    "parentTimelineMapHash",
    "childTimelineMapHash",
    "authorizedDirtyWindows",
    "unchangedMappingProofHash",
    "supersededClauseIds",
    "successorClauseIds",
    "revalidatedCommittedOperationIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "parentPictureLockHash": { "$ref": "#/$defs/sha256" },
    "childPictureLockHash": { "$ref": "#/$defs/sha256" },
    "repairOperationHash": { "$ref": "#/$defs/sha256" },
    "parentTimelineMapHash": { "$ref": "#/$defs/sha256" },
    "childTimelineMapHash": { "$ref": "#/$defs/sha256" },
    "authorizedDirtyWindows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frameRange" }
    },
    "unchangedMappingProofHash": { "$ref": "#/$defs/sha256" },
    "supersededClauseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "successorClauseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "revalidatedCommittedOperationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startFrame", "endFrameExclusive"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrameExclusive": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
