# PROJECT SNIPER environment. Next.js loads .env.local automatically; API routes pass
# it through to the Python workers they start.
#
# Packaged app: install/install.command writes runtime/sniper.env (provider, model,
# CLI paths, workspace) and never changes runtime/sniper.local.env, which is the place
# for your own settings. The package launchers ignore API keys exported in your shell.
#
# The editing workflow (Producer, Segmenter, Clipper) runs on your Codex or Claude
# subscription through the pinned CLI and needs NO API key. There is no API-key path
# for those tools and nothing falls back to one.

# ── Optional paid features (off unless you add a key AND ask for them) ──────

# Text Review (/frameio-review) only: sends still frames to Anthropic's API and is
# billed per image by Anthropic on this key. The app asks for your explicit opt-in
# before each run. Nothing else in Sniper reads this key.
# (Packaged app: put it in runtime/sniper.local.env.)
ANTHROPIC_API_KEY=

# Deepgram transcription: used only by a direct script run with
# `--provider deepgram --authorize-paid-asr deepgram`. No app route uses Deepgram;
# the app transcribes locally with whisper.cpp.
DEEPGRAM_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# LOCALHOST GUI lane. `npm run dev:local` sets this automatically (the package sets
# it in runtime/sniper.env). Local mode binds the app to loopback and applies the
# local request policy. It is private-by-default but not offline: transcript and plan
# text and rendered still frames go to your selected subscription provider.
#SNIPER_EXECUTION_MODE=local

# Editor brain: ONE provider for every call (Producer, Segmenter, Clipper).
# SNIPER_PROVIDER=codex|claude and SNIPER_BRAIN_PROVIDER=codex|legacy must agree when
# both are set (the app refuses a mismatch); the package writes both — switch with
# install/use-provider.command. Neither set: Claude Code. Every Claude subprocess gets
# an explicit model and never inherits a desktop Claude Code model selection.
#SNIPER_PROVIDER=claude
#SNIPER_BRAIN_PROVIDER=legacy
#SNIPER_CLAUDE_MODEL=opus
#CLAUDE_BIN=claude
#SNIPER_CODEX_BIN=codex
#SNIPER_CODEX_MODEL=gpt-5.6-sol
# Default reasoning is xhigh: the resolved gpt-5.6-sol build rejected `ultra`
# on 2026-07-18 (HTTP 400; allowed none|low|medium|high|xhigh).
#SNIPER_CODEX_REASONING=xhigh

# Auto Edit authoring deadline, in minutes (integer 10..240; default 45). The
# clock is PER BRAIN SPAWN — the cut pass and the visual pass each get their
# own. Raise it for full-length longform (10+ min of footage) where the visual
# pass can legitimately need more than 45 min; on expiry the brain is killed
# and the run falls back to draft salvage + review triage, or Resume Edit.
# Next must be restarted after changing this — workers inherit it at spawn.
#SNIPER_AUTHORING_TIMEOUT_MIN=45

# Review-loop kill ceilings, in minutes (integer 5..240). Overrunning one
# ABORTS the whole job, so raise these together with the authoring deadline
# for full-length longform. STAGE covers plan/cut critics + revision writers
# (default 20); the other covers rendered/QC vision-lens critics (default 25).
# Next must be restarted after changing these — workers inherit env at spawn.
#SNIPER_REVIEW_STAGE_TIMEOUT_MIN=20
#SNIPER_REVIEW_TIMEOUT_MIN=25

# The supervisor loads this file before it launches Next, so this knob really
# controls the child Node process. An explicit max-old-space-size already in
# NODE_OPTIONS wins. Valid range: integer 256..131072 MB; default 3072 MB.
# Raise it only after diagnosing memory growth—a larger heap is not a substitute
# for bounded UI polling. Auto Edit runs in a separate durable worker, so a
# dashboard restart does not cancel the edit.
#SNIPER_NEXT_HEAP_MB=3072

# Transcription is local whisper.cpp. It never downloads a model and never falls back
# to a paid service; setting this to deepgram does not authorize Deepgram (see above).
#SNIPER_TRANSCRIBE_PROVIDER=local-whisper

# whisper.cpp overrides (autodetected defaults: whisper-cli on PATH and
# ~/.cache/hyperframes/whisper/models/ggml-small.en.bin).
#WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
#WHISPER_CPP_MODEL=/absolute/path/to/ggml-small.en.bin
#WHISPER_CPP_LANGUAGE=en
#WHISPER_CPP_THREADS=8
#WHISPER_CPP_TIMEOUT_SECONDS=3600
#WHISPER_CPP_NO_GPU=0

# Reference URL intake (HTTPS YouTube, Instagram and TikTok links) downloads the
# video to this Mac with yt-dlp. It never reads browser cookies unless you tick
# "Allow Chrome cookies for this fetch" on the reference card for that one fetch;
# there is no global cookie setting.

# OPTIONAL — set to 0 to silence Python pipeline debug output (default: on)
#SNIPER_DEBUG=1

# OPTIONAL — set to 0 to silence UI/API-route debug logging (default: on)
#NEXT_PUBLIC_SNIPER_DEBUG=1

# OPTIONAL — set to 1 to force multicam pipeline debug output
#MULTICAM_DEBUG=0

# OPTIONAL — dual-cam crosstalk gate tuning (CLIPPER transcription)
#CLIPPER_CROSSTALK=0
#CLIPPER_CROSSTALK_RATIO=1.0
#CLIPPER_CROSSTALK_HANGOVER=4

# OPTIONAL — set to 1 to save each Clipper decision response as a local fixture
# under src/lib/clipper/__fixtures__ (test tooling)
#CLIPPER_DUMP_FIXTURE=0

# OPTIONAL — path override for the YuNet face-detection model (PRODUCER reframe)
#PRODUCER_YUNET_MODEL=

# OPTIONAL — fonts directory override for PRODUCER renders (render.py sets a default)
#PRODUCER_FONTS_DIR=

# OPTIONAL — set to 1 for an extra graphics-placement verification pass
#SNIPER_VERIFY_PLACEMENT=0
