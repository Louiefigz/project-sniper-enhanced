{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sniper.local/schemas/producer/scene-spec-v1.schema.json",
  "title": "SceneSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sceneId",
    "version",
    "timing",
    "canvas",
    "renderMode",
    "composition",
    "elements",
    "renderUnits",
    "captionPolicy",
    "dependencies",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sceneId": { "$ref": "#/$defs/stableId" },
    "version": { "type": "integer", "minimum": 1 },
    "timing": { "$ref": "#/$defs/timing" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "renderMode": {
      "enum": ["overlay-alpha", "takeover-opaque", "presenter-hole"]
    },
    "composition": {
      "oneOf": [
        { "$ref": "#/$defs/catalogComposition" },
        { "$ref": "#/$defs/projectComposition" }
      ]
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/element" }
    },
    "renderUnits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/renderUnit" }
    },
    "captionPolicy": {
      "enum": ["preserve", "suppress-overlap"]
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "relativeHtml": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.html$",
      "maxLength": 240
    },
    "positiveRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startFrame",
        "endFrameExclusive",
        "fps",
        "timelineMapHash"
      ],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrameExclusive": { "type": "integer", "minimum": 1 },
        "fps": { "$ref": "#/$defs/positiveRational" },
        "timelineMapHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 2, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 2, "maximum": 8192 }
      }
    },
    "scalar": {
      "type": ["string", "number", "boolean"],
      "maxLength": 4000
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "catalogComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "variables"],
      "properties": {
        "type": { "const": "catalog" },
        "kind": { "$ref": "#/$defs/stableId" },
        "variables": { "$ref": "#/$defs/variables" }
      }
    },
    "projectComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bundleId", "bundleHash", "entry", "variables"],
      "properties": {
        "type": { "const": "project" },
        "bundleId": { "$ref": "#/$defs/stableId" },
        "bundleHash": { "$ref": "#/$defs/sha256" },
        "entry": { "$ref": "#/$defs/relativeHtml" },
        "variables": { "$ref": "#/$defs/variables" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "role",
        "exposedProperties",
        "values"
      ],
      "properties": {
        "elementId": { "$ref": "#/$defs/stableId" },
        "role": { "$ref": "#/$defs/stableId" },
        "exposedProperties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        },
        "values": { "$ref": "#/$defs/variables" }
      }
    },
    "renderUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "elementIds",
        "zIndex",
        "entry",
        "compositeMode",
        "palmierGranularity"
      ],
      "properties": {
        "unitId": { "$ref": "#/$defs/stableId" },
        "elementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "zIndex": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "entry": { "$ref": "#/$defs/relativeHtml" },
        "sharedGroupId": { "$ref": "#/$defs/stableId" },
        "maskDependencyUnitIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "compositeMode": {
          "enum": ["normal", "screen", "multiply", "declared"]
        },
        "palmierGranularity": {
          "enum": ["scene", "unit"]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/stableId" },
        "id": { "$ref": "#/$defs/stableId" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": {
          "enum": ["operator", "autopilot", "reference-style"]
        },
        "requestId": { "$ref": "#/$defs/stableId" },
        "stylePackHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
