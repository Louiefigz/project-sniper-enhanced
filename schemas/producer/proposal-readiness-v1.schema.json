{
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","stage","verdict","summary","materialIssues","findings","checks"],
  "properties":{
    "schemaVersion":{"type":"integer","enum":[1]},
    "stage":{"type":"string","enum":["proposal-readiness"]},
    "verdict":{"type":"string","enum":["pass","revise","block"]},
    "summary":{"type":"string","minLength":1,"maxLength":2000},
    "materialIssues":{"type":"array","maxItems":50,"items":{
      "type":"object","additionalProperties":false,
      "required":["code","severity","lane","message","evidence","requiredAction"],
      "properties":{
        "code":{"type":"string","minLength":2,"maxLength":64},
        "severity":{"type":"string","enum":["major","critical"]},
        "lane":{"type":"string","minLength":1,"maxLength":80},
        "message":{"type":"string","minLength":1,"maxLength":2000},
        "evidence":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":1,"maxLength":1000}},
        "requiredAction":{"type":"string","minLength":1,"maxLength":2000}
      }
    }},
    "findings":{"type":"array","maxItems":100,"items":{
      "type":"object","additionalProperties":false,
      "required":["code","severity","lane","message","evidence"],
      "properties":{
        "code":{"type":"string","minLength":2,"maxLength":64},
        "severity":{"type":"string","enum":["info","minor"]},
        "lane":{"type":"string","minLength":1,"maxLength":80},
        "message":{"type":"string","minLength":1,"maxLength":2000},
        "evidence":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":1,"maxLength":1000}}
      }
    }},
    "checks":{"type":"array","maxItems":256,"items":{
      "type":"object","additionalProperties":false,
      "required":["kind","index","verdict","occurrenceIds","reason"],
      "properties":{
        "kind":{"type":"string","enum":["clause","beat"]},
        "index":{"type":"integer","minimum":0,"maximum":127},
        "verdict":{"type":"string","enum":["pass","issue"]},
        "occurrenceIds":{"type":"array","maxItems":20,"items":{"type":"integer","minimum":0,"maximum":29999}},
        "reason":{"type":"string","minLength":1,"maxLength":2000}
      }
    }}
  }
}
